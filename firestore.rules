rules_version = '2';

// Supply chain integration — Firestore security rules.
//
// Roles live on /users/{uid}.role and are the single source of truth.
// A supplier account is linked to a supplier record in two directions:
//   users/{uid}.supplierId  ->  suppliers/{supplierId}
//   suppliers/{id}.userId   ->  the Auth UID
// Only an admin can write either link.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasProfile() ? profile().role : '';
    }

    function isActive() {
      return hasProfile() && profile().get('status', 'active') == 'active';
    }

    function isAdmin() {
      return isActive() && role() == 'admin';
    }

    function isManager() {
      return isActive() && role() == 'warehouse_manager';
    }

    function isSupplier() {
      return isActive() && role() == 'supplier';
    }

    function staff() {
      return isAdmin() || isManager();
    }

    // The caller's verified email from their Auth token, lowercased.
    function callerEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // A supplier record is claimable by the caller when nobody holds it
    // yet and it carries the caller's own email address. This is what
    // lets a new supplier account link itself instead of waiting for an
    // admin to do it by hand.
    function claimableSupplier(sid) {
      return callerEmail() != ''
        && exists(/databases/$(database)/documents/suppliers/$(sid))
        && (
          get(/databases/$(database)/documents/suppliers/$(sid)).data.get('userId', '') == ''
          || get(/databases/$(database)/documents/suppliers/$(sid)).data.get('userId', '') == request.auth.uid
        )
        && get(/databases/$(database)/documents/suppliers/$(sid)).data.get('email', '').lower() == callerEmail();
    }

    // The supplier record linked to the caller, or '' if unlinked.
    function ownSupplierId() {
      return isSupplier() ? profile().get('supplierId', '') : '';
    }

    // ---------------- users ----------------
    match /users/{userId} {
      // A user reads their own profile; admins read everyone.
      // Managers may read profiles to resolve names on orders.
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin() || isManager());
      allow list: if isAdmin() || isManager();

      // Self-service signup creates the caller's own profile, always as a
      // supplier with no supplier link and active status. Any later change
      // to role, status or supplierId is an admin-only action.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'supplier'
        && request.resource.data.get('status', 'active') == 'active'
        && !('supplierId' in request.resource.data);

      // A user may edit their own display fields only.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        && request.resource.data.get('supplierId', '') == resource.data.get('supplierId', '');

      // A supplier account may attach itself to the one unclaimed
      // supplier record that carries its own email address. It can only
      // ever add supplierId, and only when it is currently unset.
      allow update: if signedIn()
        && request.auth.uid == userId
        && resource.data.role == 'supplier'
        && resource.data.get('supplierId', '') == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supplierId'])
        && claimableSupplier(request.resource.data.supplierId);

      // Admins provision, link and deactivate accounts.
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---------------- suppliers ----------------
    match /suppliers/{supplierId} {
      allow read: if isActive();

      // Only an admin registers, edits or removes supplier records.
      // Warehouse managers read the list to raise purchase orders.
      allow delete: if isAdmin();

      // A supplier account with no record of its own registers one at
      // signup. It must carry that account's own verified email address
      // and point straight back at it, so nobody can create a record on
      // another address's behalf.
      allow create: if isAdmin()
        || (
          signedIn()
          && callerEmail() != ''
          && request.resource.data.get('email', '').lower() == callerEmail()
          && request.resource.data.get('userId', '') == request.auth.uid
        );

      // An admin may change anything. Otherwise the only permitted write
      // is an account claiming an unclaimed record that carries its own
      // email address, and it may set nothing but userId, to itself.
      allow update: if isAdmin()
        || (
          signedIn()
          && callerEmail() != ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId'])
          && request.resource.data.userId == request.auth.uid
          && resource.data.get('userId', '') == ''
          && resource.data.get('email', '').lower() == callerEmail()
        );
    }

    // ---------------- products ----------------
    match /products/{productId} {
      allow read: if isActive();
      allow create, update, delete: if staff();
    }

    // ---------------- orders ----------------
    match /orders/{orderId} {
      // Staff see every order; a supplier sees only their own.
      allow get: if staff()
        || (isSupplier() && resource.data.supplierId == ownSupplierId());

      // Evaluated per candidate document: a supplier's query can only
      // succeed if every document it would return is their own, which
      // forces the client to filter by supplierId.
      allow list: if staff()
        || (
          isSupplier()
          && ownSupplierId() != ''
          && resource.data.supplierId == ownSupplierId()
        );

      allow create: if staff()
        && request.resource.data.status == 'Pending'
        && request.resource.data.receiptConfirmed == false
        && request.resource.data.items.size() > 0;

      // Staff may change status and confirm receipt. A supplier may only
      // move their own order forward and may not touch the money, the
      // items or the receipt flag.
      allow update: if staff()
        || (
          isSupplier()
          && resource.data.supplierId == ownSupplierId()
          && request.resource.data.supplierId == resource.data.supplierId
          && request.resource.data.items == resource.data.items
          && request.resource.data.totalAmount == resource.data.totalAmount
          && request.resource.data.receiptConfirmed == resource.data.receiptConfirmed
          // No 'Delivered': only the warehouse records a delivery, by
          // confirming receipt, which is what restocks inventory.
          && request.resource.data.status in ['Approved', 'Rejected', 'Processing', 'Shipped']
        );

      allow delete: if isAdmin();
    }

    // ---------------- stock movements ----------------
    match /stockMovements/{movementId} {
      allow read: if staff();
      allow create: if staff() && request.resource.data.changedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------- notifications ----------------
    match /notifications/{notificationId} {
      // Addressed to a single user, or broadcast to a role.
      // Addressed to this account, or broadcast to this role and to
      // nobody in particular. A notification carrying another account's
      // userId is never readable, whatever role it names.
      allow get, list: if isActive() && (
        resource.data.get('userId', '') == request.auth.uid
        || (
          resource.data.get('userId', '') == null
          && resource.data.get('recipientRole', '') == role()
        )
      );

      // Any signed-in participant may raise a notification (order created,
      // status changed, low stock), but never pre-read.
      allow create: if isActive() && request.resource.data.read == false;

      // The recipient may only flip it to read.
      allow update: if isActive()
        && (
          resource.data.get('userId', '') == request.auth.uid
          || (
            resource.data.get('userId', '') == null
            && resource.data.get('recipientRole', '') == role()
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
